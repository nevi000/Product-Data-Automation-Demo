# The demo runs with NO configuration at all — every value has a safe default.
# Copy to `.env` only if you want to override something.

# APP_LLM_PROVIDER=mock          # only "mock" ships in this repo
# APP_IMAGE_PROVIDER=mock
# APP_LANDED_COST_FACTOR=1.15    # pricing knobs, see app/domain/pricing.py
# APP_RETAIL_MULTIPLIER=2.5
# APP_CORS_ORIGINS=["http://localhost:5173"]

# There are NO credential settings. A real deployment would add provider API keys
# here and wire a real provider in app/services/llm and app/services/shop.
